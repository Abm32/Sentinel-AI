# Copy to .env (already gitignored) and fill in real values.

# Vultr Serverless Inference API key. Get it from the Vultr console:
# Products -> Serverless -> Inference -> your subscription -> API key.
VULTR_API_KEY=

# Model ID as returned by GET https://api.vultrinference.com/v1/models
# (Authorization: Bearer $VULTR_API_KEY). Do NOT guess this from the
# marketing name — verify it against the live endpoint first via
# packages/llm.py::list_models(). The value below is the best-evidenced
# candidate from Vultr's public model-guide docs as of this writing, NOT
# yet confirmed against the live Serverless Inference catalog:
VULTR_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8
