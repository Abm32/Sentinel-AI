# Copy to .env (already gitignored) and fill in real values.

# Vultr Serverless Inference API key. Get it from the Vultr console:
# Products -> Serverless -> Inference -> your subscription -> API key.
# Shared by BOTH models below — VultronRetriever (reranking) and the
# chat-completion reasoning model — same endpoint, same key.
VULTR_API_KEY=

# VultronRetriever tier used for evidence reranking
# (packages/tools/vultron_rerank_tool.py). Confirmed real model ID
# strings per Vultr's own docs (docs.vultr.com/how-to-rank-documents-
# with-vultronretriever-on-vultr-serverless-inference). Flash is the
# documented default: fast and cost-efficient with strong quality;
# switch to Core or Prime for denser/more cluttered documents.
#   vultr/VultronRetrieverFlash-Qwen3.5-0.8B  (0.8B, default)
#   vultr/VultronRetrieverCore-Qwen3.5-4.5B   (4.5B)
#   vultr/VultronRetrieverPrime-Qwen3.5-8B    (8B, max quality)
VULTR_RERANK_MODEL=vultr/VultronRetrieverFlash-Qwen3.5-0.8B

# Chat-completion model ID used for investigation reasoning (planner,
# hypothesis, reporter, reviewer — see packages/llm.py). VultronRetriever
# CANNOT do this job — it has no chat-completion capability, confirmed
# against Vultr's docs (see packages/llm.py's module docstring). The
# value below is NOT yet confirmed against a live
# GET https://api.vultrinference.com/v1/models call — verify it via
# packages/llm.py::list_models() before relying on this beyond local
# dry-runs with the rule-based fallback active.
VULTR_CHAT_MODEL=moonshotai/kimi-k2-instruct

# --- Microsoft Azure (optional — multi-cloud data/document layer) ---
# All three services below are optional. If unset, each tool falls back
# to a local/deterministic implementation (see packages/config.py's
# *_available() checks). The demo works with zero Azure credentials,
# same as it works with zero VULTR_API_KEY.

# Azure AI Document Intelligence (formerly Form Recognizer) — clinical
# document OCR + structured extraction (text, tables, key-value pairs).
# Console: Azure Portal -> Create Resource -> Document Intelligence.
AZURE_DOC_INTEL_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOC_INTEL_KEY=

# Azure AI Search — secondary/fallback evidence-candidate search, used
# upstream of VultronRetriever reranking (packages/tools/
# retrieval_tool.py). VultronRetriever, not Azure AI Search, is
# Sentinel's core retrieval engine per the hackathon requirement; Azure
# AI Search here only supplies candidate documents for VultronRetriever
# to rerank, and is itself optional (falls back to a local keyword-
# overlap match). Console: Azure Portal -> Create Resource -> Azure AI
# Search.
AZURE_SEARCH_ENDPOINT=https://<your-resource>.search.windows.net
AZURE_SEARCH_KEY=

# Azure Cosmos DB — investigation state + evidence storage. Console:
# Azure Portal -> Create Resource -> Azure Cosmos DB (NoSQL API).
AZURE_COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
AZURE_COSMOS_KEY=


